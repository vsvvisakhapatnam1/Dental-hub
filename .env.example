# ==============================================================================
# DENTAL HUB PRO - ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================

# 1. SUPABASE DATABASE (Text & Relational Data Storage)
# https://supabase.com -> Project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 2. CLOUDINARY (Photos & Videos Storage)
# https://cloudinary.com -> Dashboard & Upload Presets
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 3. AI AGENT (Free Tier Customer Assistant from https://aistudio.google.com/app/apikey)
# Paste your key in either or both lines below:
AI_AGENT_API_KEY=your_copied_api_key_here
GEMINI_API_KEY=your_copied_api_key_here

# 4. APP METADATA
NEXT_PUBLIC_APP_URL=http://localhost:3000
